# Copy to .env.local and fill in real values. Never commit a file with real secrets.

# ---- Database: Neon serverless Postgres ----
# Pooled URL for the app runtime, direct (unpooled) URL for Prisma migrations.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require"

# ---- Public site URL (no trailing slash) ----
NEXT_PUBLIC_SITE_URL="https://lovemedix.in"

# ---- Auth ----
SESSION_SECRET=""

# ---- Cloudinary (verification document uploads) ----
# Either set CLOUDINARY_URL, or the three parts below. If unset, the app falls back
# to letting users paste a shareable document link.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="lovemedix/medicines"
CLOUDINARY_DOCUMENTS_FOLDER="lovemedix/documents"

# ---- One-time admin bootstrap seed ----
SEED_ADMIN_EMAIL="admin@lovemedix.in"
SEED_ADMIN_PASSWORD=""
