# Copy to .env.local and fill in real values. Never commit a file with real secrets.

# ---- Database (Neon serverless Postgres) ----
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ---- Public site URL ----
# Used for canonical URLs, sitemap, OpenGraph and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://davaa.in"

# ---- Cloudinary (medicine images, prescription uploads) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="davaa/medicines"
CLOUDINARY_PRESCRIPTIONS_FOLDER="davaa/prescriptions"

# ---- Google Gemini (optional: prescription OCR / content assist) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---- One-time admin bootstrap ----
# Required by /api/admin/bootstrap. Use a long random string, then remove it.
ADMIN_SETUP_SECRET=""
