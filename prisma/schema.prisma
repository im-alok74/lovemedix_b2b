// Lovemedix — B2B pharmaceutical marketplace
// Roles: ADMIN, PHARMACY, DISTRIBUTOR. No consumer accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(150)
  phone        String?    @db.VarChar(20)
  role         UserRole   @default(PHARMACY) @map("user_type")
  status       UserStatus @default(ACTIVE)
  failedLogins Int        @default(0) @map("failed_login_count")
  lockedUntil  DateTime?  @map("locked_until")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions           Session[]
  pharmacyProfile    PharmacyProfile?
  distributorProfile DistributorProfile?
  adminProfile       AdminProfile?
  notifications      Notification[]
  auditLogs          AuditLog[]

  verifiedPharmacies   PharmacyProfile[]    @relation("PharmacyVerifier")
  verifiedDistributors DistributorProfile[] @relation("DistributorVerifier")
  verifiedDocuments    Document[]           @relation("DocumentVerifier")

  @@index([role, status])
  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @map("session_token") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  role        AdminRole @default(SUPER_ADMIN)
  permissions Json?     @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ---------------------------------------------------------------------------
// Business profiles (approval-gated)
// ---------------------------------------------------------------------------

model PharmacyProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique @map("user_id")
  pharmacyName       String             @map("pharmacy_name") @db.VarChar(255)
  registrationNumber String?            @map("registration_number") @db.VarChar(100)
  gstNumber          String?            @map("gst_number") @db.VarChar(15)
  drugLicenseNumber  String?            @map("drug_license_number") @db.VarChar(100)
  licenseExpiry      DateTime?          @map("license_expiry")
  contactPerson      String?            @map("contact_person") @db.VarChar(150)
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(255)
  addressLine1       String             @map("address_line1") @db.VarChar(255)
  addressLine2       String?            @map("address_line2") @db.VarChar(255)
  city               String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  pincode            String             @db.VarChar(10)
  country            String             @default("India") @db.VarChar(100)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         Int?               @map("verified_by")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier  User?      @relation("PharmacyVerifier", fields: [verifiedBy], references: [id])
  documents Document[]

  inventory        PharmacyInventory[]
  purchaseOrders   PurchaseOrder[]
  medicineRequests MedicineRequest[]
  customers        Customer[]
  sales            Sale[]

  @@index([verificationStatus])
  @@index([city, state])
  @@map("pharmacy_profiles")
}

model DistributorProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique @map("user_id")
  companyName        String             @map("company_name") @db.VarChar(255)
  businessLicense    String?            @map("business_license") @db.VarChar(100)
  drugLicenseNumber  String?            @map("drug_license_number") @db.VarChar(100)
  licenseExpiry      DateTime?          @map("license_expiry")
  gstNumber          String?            @map("gst_number") @db.VarChar(15)
  contactPerson      String?            @map("contact_person") @db.VarChar(150)
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(255)
  addressLine1       String             @map("address_line1") @db.VarChar(255)
  addressLine2       String?            @map("address_line2") @db.VarChar(255)
  city               String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  pincode            String             @db.VarChar(10)
  country            String             @default("India") @db.VarChar(100)
  minOrderValue      Decimal            @default(0) @map("min_order_value") @db.Decimal(12, 2)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         Int?               @map("verified_by")
  isActive           Boolean            @default(true) @map("is_active")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier  User?      @relation("DistributorVerifier", fields: [verifiedBy], references: [id])
  documents Document[]

  listings         DistributorListing[]
  purchaseOrders   PurchaseOrder[]
  medicineRequests MedicineRequest[]

  @@index([verificationStatus])
  @@index([city, state])
  @@map("distributor_profiles")
}

model Document {
  id                   Int                @id @default(autoincrement())
  ownerType            ProfileType        @map("owner_type")
  pharmacyProfileId    Int?               @map("pharmacy_profile_id")
  distributorProfileId Int?               @map("distributor_profile_id")
  documentType         DocumentType       @map("document_type")
  fileName             String             @map("file_name") @db.VarChar(255)
  fileUrl              String             @map("file_url") @db.VarChar(500)
  fileSize             Int?               @map("file_size")
  mimeType             String?            @map("mime_type") @db.VarChar(100)
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason      String?            @map("rejection_reason")
  verifiedAt           DateTime?          @map("verified_at")
  verifiedBy           Int?               @map("verified_by")
  expiresAt            DateTime?          @map("expires_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  pharmacyProfile    PharmacyProfile?    @relation(fields: [pharmacyProfileId], references: [id], onDelete: Cascade)
  distributorProfile DistributorProfile? @relation(fields: [distributorProfileId], references: [id], onDelete: Cascade)
  verifier           User?               @relation("DocumentVerifier", fields: [verifiedBy], references: [id])

  @@index([pharmacyProfileId])
  @@index([distributorProfileId])
  @@index([verificationStatus])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Medicine master catalog (admin-owned)
// ---------------------------------------------------------------------------

model Category {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  medicines Medicine[]

  @@index([slug])
  @@map("categories")
}

model Medicine {
  id                   Int            @id @default(autoincrement())
  name                 String         @db.VarChar(255)
  genericName          String?        @map("generic_name") @db.VarChar(255)
  manufacturer         String?        @db.VarChar(255)
  categoryId           Int?           @map("category_id")
  form                 String?        @db.VarChar(50)
  strength             String?        @db.VarChar(50)
  packSize             String?        @map("pack_size") @db.VarChar(50)
  hsnCode              String?        @map("hsn_code") @db.VarChar(20)
  mrp                  Decimal        @db.Decimal(10, 2)
  gstRate              Decimal        @default(5) @map("gst_rate") @db.Decimal(5, 2)
  requiresPrescription Boolean        @default(false) @map("requires_prescription")
  description          String?
  photoUrl             String?        @map("photo_url") @db.VarChar(500)
  status               MedicineStatus @default(ACTIVE)
  slug                 String         @unique @db.VarChar(320)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  category           Category?            @relation(fields: [categoryId], references: [id])
  images             MedicineImage[]
  listings           DistributorListing[]
  pharmacyInventory  PharmacyInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  medicineRequests   MedicineRequest[]
  saleItems          SaleItem[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("medicines")
}

model MedicineImage {
  id         Int      @id @default(autoincrement())
  medicineId Int      @map("medicine_id")
  imageUrl   String   @map("image_url") @db.VarChar(500)
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
  @@map("medicine_images")
}

// ---------------------------------------------------------------------------
// Distributor sellable stock
// ---------------------------------------------------------------------------

model DistributorListing {
  id               Int       @id @default(autoincrement())
  distributorId    Int       @map("distributor_id")
  medicineId       Int       @map("medicine_id")
  batchNumber      String?   @map("batch_number") @db.VarChar(100)
  mfgDate          DateTime? @map("mfg_date")
  expiryDate       DateTime  @map("expiry_date")
  mrp              Decimal   @db.Decimal(10, 2)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0) @map("reserved_quantity")
  minOrderQuantity Int       @default(1) @map("min_order_quantity")
  hsnCode          String?   @map("hsn_code") @db.VarChar(20)
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  distributor        DistributorProfile  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  medicine           Medicine            @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([distributorId, medicineId, batchNumber])
  @@index([distributorId, isActive])
  @@index([medicineId])
  @@index([expiryDate])
  @@map("distributor_listings")
}

// ---------------------------------------------------------------------------
// B2B purchase orders (pharmacy buys in bulk from distributor)
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  orderNumber     String              @unique @map("order_number") @db.VarChar(40)
  pharmacyId      Int                 @map("pharmacy_id")
  distributorId   Int                 @map("distributor_id")
  status          PurchaseOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus       @default(PENDING) @map("payment_status")
  subtotal        Decimal             @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(12, 2)
  paymentMethod   String?             @map("payment_method") @db.VarChar(50)
  transactionRef  String?             @map("transaction_ref") @db.VarChar(255)
  pharmacyNote    String?             @map("pharmacy_note")
  distributorNote String?             @map("distributor_note")
  expectedBy      DateTime?           @map("expected_by")
  confirmedAt     DateTime?           @map("confirmed_at")
  shippedAt       DateTime?           @map("shipped_at")
  deliveredAt     DateTime?           @map("delivered_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  pharmacy    PharmacyProfile      @relation(fields: [pharmacyId], references: [id])
  distributor DistributorProfile   @relation(fields: [distributorId], references: [id])
  items       PurchaseOrderItem[]
  events      PurchaseOrderEvent[]
  invoice     Invoice?

  @@index([pharmacyId, status])
  @@index([distributorId, status])
  @@index([orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                   Int       @id @default(autoincrement())
  orderId              Int       @map("order_id")
  medicineId           Int       @map("medicine_id")
  distributorListingId Int?      @map("distributor_listing_id")
  quantity             Int
  unitPrice            Decimal   @map("unit_price") @db.Decimal(10, 2)
  mrp                  Decimal?  @db.Decimal(10, 2)
  discountPercent      Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  gstRate              Decimal   @default(0) @map("gst_rate") @db.Decimal(5, 2)
  lineTotal            Decimal   @map("line_total") @db.Decimal(12, 2)
  batchNumber          String?   @map("batch_number") @db.VarChar(100)
  expiryDate           DateTime? @map("expiry_date")
  createdAt            DateTime  @default(now()) @map("created_at")

  order              PurchaseOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine           Medicine            @relation(fields: [medicineId], references: [id])
  distributorListing DistributorListing? @relation(fields: [distributorListingId], references: [id])

  @@index([orderId])
  @@map("purchase_order_items")
}

model PurchaseOrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  status    String   @db.VarChar(50)
  note      String?
  actorId   Int?     @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("purchase_order_events")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique @map("order_id")
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate   DateTime      @default(now()) @map("invoice_date")
  dueDate       DateTime?     @map("due_date")
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paidAt        DateTime?     @map("paid_at")
  pdfUrl        String?       @map("pdf_url") @db.VarChar(500)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Pharmacy requests for new / out-of-stock medicines
// ---------------------------------------------------------------------------

model MedicineRequest {
  id                Int                   @id @default(autoincrement())
  pharmacyId        Int                   @map("pharmacy_id")
  distributorId     Int?                  @map("distributor_id")
  medicineId        Int?                  @map("medicine_id")
  kind              MedicineRequestKind   @default(OUT_OF_STOCK)
  requestedName     String?               @map("requested_name") @db.VarChar(255)
  manufacturer      String?               @db.VarChar(255)
  strength          String?               @db.VarChar(50)
  packSize          String?               @map("pack_size") @db.VarChar(50)
  requestedQuantity Int                   @default(1) @map("requested_quantity")
  status            MedicineRequestStatus @default(OPEN)
  notes             String?
  resolutionNote    String?               @map("resolution_note")
  fulfilledAt       DateTime?             @map("fulfilled_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  pharmacy    PharmacyProfile     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  distributor DistributorProfile? @relation(fields: [distributorId], references: [id])
  medicine    Medicine?           @relation(fields: [medicineId], references: [id])

  @@index([pharmacyId, status])
  @@index([distributorId, status])
  @@index([kind, status])
  @@map("medicine_requests")
}

// ---------------------------------------------------------------------------
// Pharmacy shop management (inventory, customers, retail sales)
// ---------------------------------------------------------------------------

model PharmacyInventory {
  id           Int       @id @default(autoincrement())
  pharmacyId   Int       @map("pharmacy_id")
  medicineId   Int       @map("medicine_id")
  batchNumber  String?   @map("batch_number") @db.VarChar(100)
  mfgDate      DateTime? @map("mfg_date")
  expiryDate   DateTime? @map("expiry_date")
  mrp          Decimal   @db.Decimal(10, 2)
  costPrice    Decimal   @default(0) @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal   @map("selling_price") @db.Decimal(10, 2)
  quantity     Int       @default(0)
  reorderLevel Int       @default(0) @map("reorder_level")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  pharmacy  PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine  Medicine        @relation(fields: [medicineId], references: [id])
  saleItems SaleItem[]

  @@unique([pharmacyId, medicineId, batchNumber])
  @@index([pharmacyId, isActive])
  @@index([medicineId])
  @@index([expiryDate])
  @@map("pharmacy_inventory")
}

model Customer {
  id         Int      @id @default(autoincrement())
  pharmacyId Int      @map("pharmacy_id")
  name       String   @db.VarChar(150)
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  address    String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  sales    Sale[]

  @@unique([pharmacyId, phone])
  @@index([pharmacyId])
  @@map("customers")
}

model Sale {
  id              Int           @id @default(autoincrement())
  pharmacyId      Int           @map("pharmacy_id")
  customerId      Int?          @map("customer_id")
  billNumber      String        @map("bill_number") @db.VarChar(40)
  billDate        DateTime      @default(now()) @map("bill_date")
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PAID) @map("payment_status")
  paymentMethod   String?       @map("payment_method") @db.VarChar(50)
  prescriptionRef String?       @map("prescription_ref") @db.VarChar(255)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  pharmacy PharmacyProfile @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  @@unique([pharmacyId, billNumber])
  @@index([pharmacyId, billDate])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                  Int       @id @default(autoincrement())
  saleId              Int       @map("sale_id")
  medicineId          Int       @map("medicine_id")
  pharmacyInventoryId Int?      @map("pharmacy_inventory_id")
  description         String    @db.VarChar(255)
  quantity            Int
  unitPrice           Decimal   @map("unit_price") @db.Decimal(10, 2)
  discountPercent     Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  gstRate             Decimal   @default(0) @map("gst_rate") @db.Decimal(5, 2)
  lineTotal           Decimal   @map("line_total") @db.Decimal(12, 2)
  batchNumber         String?   @map("batch_number") @db.VarChar(100)
  expiryDate          DateTime? @map("expiry_date")
  createdAt           DateTime  @default(now()) @map("created_at")

  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine          Medicine           @relation(fields: [medicineId], references: [id])
  pharmacyInventory PharmacyInventory? @relation(fields: [pharmacyInventoryId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// Platform-wide
// ---------------------------------------------------------------------------

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String?
  link      String?   @db.VarChar(300)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String?
  type        String   @default("string") @db.VarChar(30)
  description String?
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  PHARMACY
  DISTRIBUTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProfileType {
  PHARMACY
  DISTRIBUTOR
}

enum DocumentType {
  DRUG_LICENSE
  GST_CERTIFICATE
  BUSINESS_REGISTRATION
  ADDRESS_PROOF
  IDENTITY_PROOF
  OTHER
}

enum MedicineStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum MedicineRequestKind {
  OUT_OF_STOCK
  NEW_MEDICINE
}

enum MedicineRequestStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  CANCELLED
}
